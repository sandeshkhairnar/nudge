# ─────────────────────────────────────────────────────────────────────────────
# Nudge Engine v4.0 — Environment Variables
# Copy this file to .env and fill in the values marked REQUIRED.
# Restart the engine after any change.
# ─────────────────────────────────────────────────────────────────────────────


# ── AI Provider ───────────────────────────────────────────────────────────────
# REQUIRED — controls the get_llm() factory. One of: claude | gemini | openai | groq
AI_PROVIDER=claude

# ── Groq (Llama-based) ────────────────────────────────────────────────────────
# Required when AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Optional overrides (defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ── Claude (Anthropic) ────────────────────────────────────────────────────────
# Required when AI_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides (defaults shown)
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_FAST_MODEL=claude-haiku-4-5

# ── Gemini (Google) ───────────────────────────────────────────────────────────
# Required when AI_PROVIDER=gemini
GOOGLE_API_KEY=AIza...
# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FAST_MODEL=gemini-1.5-flash

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required when AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Optional overrides (defaults shown)
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini


# ── Infrastructure ────────────────────────────────────────────────────────────
# REQUIRED — Supabase project URL (find in: Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# REQUIRED — Service-role key (NOT the anon key). Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# REQUIRED — Redis connection string
REDIS_URL=redis://localhost:6379/0


# ── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED — Shared secret between NestJS backend and this engine.
# Set the same value in both services. Used as X-Engine-Secret request header.
ENGINE_SECRET=change-me-to-a-long-random-string


# ── Optional Integrations ─────────────────────────────────────────────────────
# Slack incoming webhook URL — omit to disable Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# SendGrid API key — omit to disable digest emails
SENDGRID_API_KEY=SG....

# GitHub webhook secret — omit to skip HMAC-SHA256 signature verification
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret


# ── LangSmith Observability ───────────────────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true in staging/production to debug agent reasoning
LANGCHAIN_TRACING_V2=false
# Required only when tracing is enabled
LANGCHAIN_API_KEY=ls__...


# ── Agent Tuning (optional — defaults shown) ──────────────────────────────────
# Hard cap on AgentExecutor tool calls per event (prevents runaway loops)
AGENT_MAX_ITERATIONS=5

# Max AI calls allowed per workspace per hour (Redis sliding window)
RATE_LIMIT_CALLS_PER_HOUR=60

# ConversationBufferWindowMemory — number of turns kept in context
MEMORY_WINDOW_K=10

# Redis TTL for workspace conversation memory in seconds (default: 24 h)
MEMORY_TTL_SECONDS=86400

# Days without a task update before stall detection triggers a nudge
STALL_THRESHOLD_DAYS=3
